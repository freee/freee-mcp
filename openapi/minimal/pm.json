        ]
      }
    },
    "/workloads": {
      "get": {
        "summary": "工数詳細の取得",
        "description": "取得対象の従業員の工数実績の詳細を返します。 取得対象従業員と年月の取得範囲で絞り込みできます。",
        "parameters": [
          {
            "name": "company_id",
            "in": "query",
            "type": "integer",
            "required": true,
            "description": "事業所ID"
          },
          {
            "name": "employees_scope",
            "in": "query",
            "type": "string",
            "required": false,
            "description": "取得対象従業員の検索スコープです。 <ul> <li> allを指定した場合は全従業員が対象です。 絞り込みを行わない場合にご使用ください。 person_ids, team_idsでの絞り込みはできません。 </li> <li> teamを指定した場合はチーム単位で絞り込みが可能です。 team_idsでの絞り込みができます。 person_idsでの絞り込みはできません。 </li> <li> employeeを指定した場合はperson_idsによる絞り込みができます。 team_idsでの絞り込みは行なえません。 </li> <li> scopeを指定しない場合はログインユーザの情報のみの取得です。 </li> </ul>"
          },
          {
            "name": "person_ids[]",
            "in": "query",
            "type": "array",
            "required": false,
            "description": "取得対象従業員のユーザID",
            "explode": true
          },
          {
            "name": "team_ids[]",
            "in": "query",
            "type": "array",
            "required": false,
            "description": "取得対象のチームID",
            "explode": true
          },
          {
            "name": "year_month",
            "in": "query",
            "type": "string",
            "required": true,
            "description": "取得対象範囲（YYYY-MM）"
          },
          {
            "name": "limit",
            "in": "query",
            "type": "integer",
            "required": false,
            "description": "取得レコードの件数（デフォルト：50, 最小：1, 最大100）"
          },
          {
            "name": "offset",
            "in": "query",
            "type": "integer",
            "required": false,
            "description": "取得レコードのオフセット（デフォルト：0）"
          }
        ]
      },
      "post": {
        "summary": "工数登録",
        "description": "工数を登録することが出来ます。",
        "hasJsonBody": true
      }
    },
    "/workloads/{id}": {
      "delete": {
        "summary": "工数削除",
        "description": "指定した工数を削除します。",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "type": "integer",
            "required": true,
            "description": "工数ID"
          },
          {
            "name": "company_id",
            "in": "query",
            "type": "integer",
            "required": true,
            "description": "事業所ID"
          }
        ]
      },
      "patch": {
        "summary": "工数編集",
        "description": "指定した工数の情報を更新します。リクエストに含まれていないフィールドは更新されません。memo と workload_tags は null（または空）で削除できます。",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "type": "integer",
            "required": true,
            "description": "工数ID"
          }
        ],
        "hasJsonBody": true
      }
    },
