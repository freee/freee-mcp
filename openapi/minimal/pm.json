    "/labor_budgets": {
      "get": {
        "summary": "人件費予算一覧の取得",
        "description": "この事業所の人件費予算の一覧を返します。プロジェクト・従業員・年月範囲 で絞り込みができます。対象プロジェクト数が一定値を超えるとエラーとなります。その場合はプロジェクトIDまたは従業員IDを指定して絞り込む必要があります。",
        "parameters": [
          {
            "name": "company_id",
            "in": "query",
            "type": "integer",
            "required": true,
            "description": "事業所ID"
          },
          {
            "name": "project_id",
            "in": "query",
            "type": "integer",
            "required": false,
            "description": "プロジェクトID"
          },
          {
            "name": "person_id",
            "in": "query",
            "type": "integer",
            "required": false,
            "description": "従業員ID"
          },
          {
            "name": "from",
            "in": "query",
            "type": "string",
            "required": false,
            "description": "取得対象の開始年月（YYYY-MM）。指定した年月を含みます。"
          },
          {
            "name": "to",
            "in": "query",
            "type": "string",
            "required": false,
            "description": "取得対象の終了年月（YYYY-MM）。指定した年月を含みます。"
          },
          {
            "name": "limit",
            "in": "query",
            "type": "integer",
            "required": false,
            "description": "取得レコードの件数（デフォルト：50, 最小：1, 最大：100）"
          },
          {
            "name": "offset",
            "in": "query",
            "type": "integer",
            "required": false,
            "description": "取得レコードのオフセット（デフォルト：0）"
          }
        ]
      }
    },
    "/labor_budgets/projects/{project_id}/people/{person_id}/year_month/{year_month}": {
      "put": {
        "summary": "人件費予算の更新",
        "description": "指定したプロジェクト・従業員・年月の予定工数（時間）と人件費予算の金額を更新します。金額は従業員の単価に基づき、自動で更新されます。",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "type": "integer",
            "required": true,
            "description": "プロジェクトID"
          },
          {
            "name": "person_id",
            "in": "path",
            "type": "integer",
            "required": true,
            "description": "対象従業員ID"
          },
          {
            "name": "year_month",
            "in": "path",
            "type": "string",
            "required": true,
            "description": "対象年月（YYYY-MM）"
          }
        ],
        "hasJsonBody": true
      }
    },
