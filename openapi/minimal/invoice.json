        "parameters": [
          {
            "name": "id",
            "in": "path",
            "type": "integer",
            "required": true,
            "description": "納品書ID"
          }
        ],
        "hasJsonBody": true
      }
    },
    "/delivery_slips/{id}/cancel": {
      "put": {
