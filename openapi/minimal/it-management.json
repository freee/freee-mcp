{
  "paths": {
    "/hub/it_management/applications": {
      "get": {
        "summary": "アプリ一覧取得（β版）",
        "description": "利用中 (未アーカイブ) のアプリ一覧をカーソルページネーションで取得します。\n`keyword` を指定すると、テナント名、アプリ名、標準アプリの slug、標準アプリの提供会社名を対象に部分一致検索を行います (空白区切りで AND 検索)。",
        "parameters": [
          {
            "name": "company_id",
            "in": "query",
            "type": "integer",
            "required": true,
            "description": "事業所ID",
            "explode": false
          },
          {
            "name": "keyword",
            "in": "query",
            "type": "string",
            "required": false,
            "description": "テナント名 / アプリ名 / 標準アプリの slug / 標準アプリの提供会社名の部分一致検索キーワード (空白区切りで AND 検索)",
            "explode": false
          },
          {
            "name": "page_token",
            "in": "query",
            "type": "string",
            "required": false,
            "description": "ページネーションのトークン",
            "explode": false
          },
          {
            "name": "page_size",
            "in": "query",
            "type": "integer",
            "required": false,
            "description": "1ページあたりの取得件数（デフォルト25、最大100）",
            "explode": false
          }
        ]
      }
    },
    "/hub/it_management/applications/{id}": {
      "get": {
        "summary": "アプリ詳細取得（β版）",
        "description": "アプリの詳細を取得します。",
        "parameters": [
          {
            "name": "company_id",
            "in": "query",
            "type": "integer",
            "required": true,
            "description": "事業所ID",
            "explode": false
          },
          {
            "name": "id",
            "in": "path",
            "type": "string",
            "required": true,
            "description": "アプリID"
          }
        ]
      },
      "patch": {
        "summary": "アプリ部分更新（β版）",
        "description": "アプリの所属会社 / テナント名を部分的に更新します。\n\n## 注意点\n\n- 指定されたパラメーターのみが更新されます。\n- アプリ名はこの API では変更できません。",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "type": "string",
            "required": true,
            "description": "アプリID"
          }
        ],
        "hasJsonBody": true
      }
    },
