    "/hub/it_management/application_masters": {
      "get": {
        "summary": "アプリマスタ一覧取得（β版）",
        "description": "freee IT管理 のアプリカタログに含まれる標準アプリマスタの一覧をカーソルページネーションで取得します。\n`keyword` を指定すると、アプリ名、slug、提供会社名を対象に部分一致検索を行います (空白区切りで AND 検索)。\n\n## 注意点\n\n- ロールが「一般」のユーザーでは、一覧は常に空になります。詳細取得は利用できます。\n- フリープランでは、プランで利用できるアプリマスタだけが返ります。",
        "parameters": [
          {
            "name": "company_id",
            "in": "query",
            "type": "integer",
            "required": true,
            "description": "事業所ID",
            "explode": false
          },
          {
            "name": "keyword",
            "in": "query",
            "type": "string",
            "required": false,
            "description": "アプリ名 / slug / 提供会社名の部分一致検索キーワード (空白区切りで AND 検索)",
            "explode": false
          },
          {
            "name": "page_token",
            "in": "query",
            "type": "string",
            "required": false,
            "description": "ページネーションのトークン",
            "explode": false
          },
          {
            "name": "page_size",
            "in": "query",
            "type": "integer",
            "required": false,
            "description": "1ページあたりの取得件数（デフォルト25、最大100）",
            "explode": false
          }
        ]
      }
    },
    "/hub/it_management/application_masters/{id}": {
      "get": {
        "summary": "アプリマスタ詳細取得（β版）",
        "description": "アプリマスタの詳細を取得します。\n\n## 注意点\n\n- フリープランでは、プランで利用できないアプリマスタを指定すると 404 になります。",
        "parameters": [
          {
            "name": "company_id",
            "in": "query",
            "type": "integer",
            "required": true,
            "description": "事業所ID",
            "explode": false
          },
          {
            "name": "id",
            "in": "path",
            "type": "string",
            "required": true,
            "description": "アプリマスタID"
          }
        ]
      }
    },
