    "/hub/it_management/assets/{asset_id}/members": {
      "get": {
        "summary": "備品利用者一覧取得（β版）",
        "description": "指定した備品の利用者履歴をカーソルページネーションで取得します。",
        "parameters": [
          {
            "name": "company_id",
            "in": "query",
            "type": "integer",
            "required": true,
            "description": "事業所ID",
            "explode": false
          },
          {
            "name": "asset_id",
            "in": "path",
            "type": "string",
            "required": true,
            "description": "備品ID"
          },
          {
            "name": "current",
            "in": "query",
            "type": "boolean",
            "required": false,
            "description": "`true` の場合、現在割当中 (end_at が null) のみを返す",
            "explode": false
          },
          {
            "name": "member_id",
            "in": "query",
            "type": "string",
            "required": false,
            "description": "メンバー ID による絞り込み",
            "explode": false
          },
          {
            "name": "page_token",
            "in": "query",
            "type": "string",
            "required": false,
            "description": "ページネーションのトークン",
            "explode": false
          },
          {
            "name": "page_size",
            "in": "query",
            "type": "integer",
            "required": false,
            "description": "1ページあたりの取得件数（デフォルト25、最大100）",
            "explode": false
          }
        ]
      },
      "post": {
        "summary": "備品にメンバーを割当（β版）",
        "description": "備品にメンバーを割当てます。\n\n## 注意点\n\n- start_at を省略すると当日になります。\n- 現在割当中のメンバーがいて、start_at を省略するか現在の割当の開始日以降を指定した場合、現在の割当は自動で終了します。終了日には新しい start_at (省略時は当日) が設定されます。\n- end_at を省略すると null (現在割当中) になります。ただし start_at を指定し、その日以降に始まる別の履歴がある場合は、その履歴の start_at が end_at に設定されます。",
        "parameters": [
          {
            "name": "asset_id",
            "in": "path",
            "type": "string",
            "required": true,
            "description": "備品ID"
          }
        ],
        "hasJsonBody": true
