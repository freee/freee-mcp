{
  "paths": {
    "/hub/it_management/application_accounts": {
      "get": {
        "summary": "アカウント一覧取得（β版）",
        "description": "アカウントの一覧をカーソルページネーションで取得します。",
        "parameters": [
          {
            "name": "company_id",
            "in": "query",
            "type": "integer",
            "required": true,
            "description": "事業所ID",
            "explode": false
          },
          {
            "name": "page_token",
            "in": "query",
            "type": "string",
            "required": false,
            "description": "ページネーションのトークン",
            "explode": false
          },
          {
            "name": "page_size",
            "in": "query",
            "type": "integer",
            "required": false,
            "description": "1ページあたりの取得件数（デフォルト25、最大100）",
            "explode": false
          },
          {
            "name": "application_id",
            "in": "query",
            "type": "string",
            "required": false,
            "description": "アプリケーションIDでフィルタ",
            "explode": false
          },
          {
            "name": "keyword",
            "in": "query",
            "type": "string",
            "required": false,
            "description": "キーワード検索（account に部分一致）",
            "explode": false
          },
          {
            "name": "status_id",
            "in": "query",
            "type": "string",
            "required": false,
            "description": "ステータスIDでフィルタ",
            "explode": false
          },
          {
            "name": "member_id",
            "in": "query",
            "type": "string",
            "required": false,
            "description": "アカウントホルダーのメンバーIDでフィルタ",
            "explode": false
          }
        ]
      },
      "post": {
        "summary": "アカウント作成（β版）",
        "description": "アカウントを作成します。",
        "hasJsonBody": true
      }
    },
    "/hub/it_management/application_accounts/{id}": {
      "get": {
        "summary": "アカウント詳細取得（β版）",
        "description": "アカウントの詳細を取得します。",
        "parameters": [
          {
            "name": "company_id",
            "in": "query",
            "type": "integer",
            "required": true,
            "description": "事業所ID",
            "explode": false
          },
          {
            "name": "id",
            "in": "path",
            "type": "string",
            "required": true,
            "description": "アカウントID"
          }
        ]
      },
      "delete": {
        "summary": "アカウント削除（β版）",
        "description": "アカウントを削除します（ソフトデリート）。",
        "parameters": [
          {
            "name": "company_id",
            "in": "query",
            "type": "integer",
            "required": true,
            "description": "事業所ID",
            "explode": false
          },
          {
            "name": "id",
            "in": "path",
            "type": "string",
            "required": true,
            "description": "アカウントID"
          }
        ]
      },
      "patch": {
        "summary": "アカウント部分更新（β版）",
        "description": "アカウントを部分的に更新します。\n\n## 注意点\n\n- 指定されたパラメータのみが更新されます。",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "type": "string",
            "required": true,
            "description": "アカウントID"
          }
        ],
        "hasJsonBody": true
      }
    },
