        "description": "サーベイ種別"
      },
      "Survey.AnswerPeriodUnit": {
        "type": "string",
        "enum": [
          "days",
          "weeks"
        ],
        "description": "回答期間の単位"
      },
      "Survey.ReminderSetting": {
        "type": "object",
        "required": [
          "id",
          "base_survey_id",
          "days_before",
          "mail",
          "slack",
          "is_enabled",
          "line_works"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "example": 1
          },
          "base_survey_id": {
            "type": "integer",
            "format": "int64",
            "example": 1
          },
          "days_before": {
            "type": "integer",
            "format": "int32",
            "description": "何日前に通知するか",
            "example": 3
          },
          "mail": {
            "type": "boolean",
            "description": "メール通知するか",
            "example": true
          },
          "slack": {
            "type": "boolean",
            "description": "Slack通知するか",
            "example": false
          },
          "is_enabled": {
            "type": "boolean",
            "description": "有効か",
            "example": true
          },
          "line_works": {
            "type": "boolean",
            "description": "LINE WORKS通知するか",
            "example": false
          }
        },
        "description": "リマインド設定",
        "additionalProperties": false
      },
      "Survey.ScheduleType": {
        "type": "string",
        "enum": [
