        "required": [
          "id",
          "base_survey_id",
          "month",
          "schedule_type",
          "date",
          "week",
          "weekday",
          "is_enabled"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "example": 1
          },
          "base_survey_id": {
            "type": "integer",
            "format": "int64",
            "example": 1
          },
          "month": {
            "type": "integer",
            "format": "int32",
            "description": "繰り返し間隔(月数)",
            "example": 1
          },
          "schedule_type": {
            "$ref": "#/components/schemas/Survey.ScheduleType"
          },
          "date": {
            "type": "integer",
            "format": "int32",
            "nullable": true,
            "description": "開始日(schedule_typeがdateの場合)",
            "example": 1
          },
          "week": {
            "type": "integer",
            "format": "int32",
            "nullable": true,
            "description": "第何週(schedule_typeがweekdayの場合)",
            "example": 1
          },
          "weekday": {
            "type": "integer",
            "format": "int32",
            "nullable": true,
            "description": "曜日(schedule_typeがweekdayの場合)",
            "example": 1
          },
          "is_enabled": {
            "type": "boolean",
            "description": "有効か",
            "example": true
          }
        },
        "description": "繰り返し設定",
        "additionalProperties": false
      },
      "Survey.QuestionsSummary": {
