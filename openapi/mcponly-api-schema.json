        "description": "実施回",
        "additionalProperties": false
      },
      "Survey.SurveyDetails": {
        "type": "object",
        "required": [
          "id",
          "title",
          "description",
          "start_date",
          "end_date",
          "status",
          "answered_ratio",
          "target_count",
          "unanswered_count",
          "viewer_scope"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "description": "実施回ID",
            "example": 1
          },
          "title": {
            "type": "string",
            "description": "タイトル",
            "example": "2026年8月度"
          },
          "description": {
            "type": "string",
            "description": "説明",
            "example": "入社1ヶ月の従業員向けアンケートです"
          },
          "start_date": {
            "type": "string",
            "format": "date-time",
            "description": "開始日(ISO8601)",
            "example": "2026-08-01T00:00:00Z"
          },
          "end_date": {
            "type": "string",
            "format": "date-time",
            "description": "終了日(ISO8601)",
            "example": "2026-08-08T00:00:00Z"
          },
          "status": {
            "$ref": "#/components/schemas/Survey.SurveyStatus"
          },
          "answered_ratio": {
            "type": "number",
            "format": "float",
            "nullable": true,
            "description": "回答率",
            "example": 0.5
          },
          "target_count": {
            "type": "integer",
            "format": "int32",
            "nullable": true,
            "description": "対象者数",
            "example": 20
          },
          "unanswered_count": {
            "type": "integer",
            "format": "int32",
            "nullable": true,
            "description": "未回答者数",
            "example": 10
          },
          "viewer_scope": {
            "type": "string",
            "description": "閲覧範囲",
            "example": "all"
          }
        },
        "description": "実施回の詳細",
        "additionalProperties": false
