            "description": "一時停止中か",
            "example": false
          },
          "survey_type": {
            "$ref": "#/components/schemas/Survey.SurveyType"
          },
          "answer_period": {
            "type": "integer",
            "format": "int32",
            "description": "回答期間",
            "example": 7
          },
          "answer_period_unit": {
            "$ref": "#/components/schemas/Survey.AnswerPeriodUnit"
          },
          "reminder_setting": {
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/Survey.ReminderSetting"
              }
            ],
            "nullable": true
          },
          "repeat_frequency_setting": {
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/Survey.RepeatFrequencySetting"
              }
            ],
            "nullable": true
          },
          "questions_summary": {
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/Survey.QuestionsSummary"
              }
            ],
            "nullable": true
          },
          "viewer_scope": {
            "type": "string",
            "description": "閲覧範囲",
            "example": "all"
          }
        },
        "description": "サーベイ企画",
        "additionalProperties": false
      },
      "Survey.SurveyStatus": {
