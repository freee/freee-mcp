        },
        "explode": false
      },
      "Survey.GetSurveyRequest.company_id": {
        "name": "company_id",
        "in": "query",
        "required": true,
        "description": "事業所ID",
        "schema": {
          "type": "integer",
          "format": "int64"
        },
        "explode": false
      },
      "Survey.GetSurveyRequest.survey_id": {
        "name": "survey_id",
        "in": "path",
        "required": true,
        "description": "実施回ID",
