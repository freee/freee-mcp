            "type": "integer",
            "format": "int32",
            "nullable": true,
            "description": "テンプレート由来の質問数",
            "example": 10
          },
          "additional_questions_count": {
            "type": "integer",
            "format": "int32",
            "nullable": true,
            "description": "追加された質問数",
            "example": 3
          }
        },
        "description": "質問数のサマリ",
        "additionalProperties": false
      },
      "Survey.BaseSurvey": {
        "type": "object",
        "required": [
          "id",
          "title",
          "description",
          "template_id",
          "is_auto_add",
          "next_start_date",
          "is_pause",
          "survey_type",
          "answer_period",
          "answer_period_unit",
          "reminder_setting",
          "repeat_frequency_setting",
          "questions_summary",
          "viewer_scope"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "description": "サーベイ企画ID",
            "example": 1
          },
