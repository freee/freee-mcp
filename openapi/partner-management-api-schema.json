            "allOf": [
              {
                "$ref": "#/components/schemas/PartnerManagement.Orderer.CompanyUsers.NotificationSettings"
              }
            ],
            "description": "通知設定"
          },
          "invitation_sent_at": {
            "type": "string",
            "nullable": true,
            "format": "date-time",
            "description": "招待送信日時",
            "example": "2025-11-20T09:00:00+09:00"
          },
          "invitation_accepted_at": {
            "type": "string",
            "nullable": true,
            "format": "date-time",
            "description": "招待受諾日時。未受諾は null",
            "example": "2025-11-21T14:00:00+09:00"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "作成日時",
            "example": "2025-11-19T10:00:00+09:00"
          }
        },
        "description": "企業ユーザー",
        "additionalProperties": false
      },
      "PartnerManagement.Orderer.Sections.Section": {
        "type": "object",
        "required": [
          "id",
          "name",
          "code"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "description": "Section ID",
            "example": 34
