            "type": "string",
            "nullable": true,
            "description": "部門コード。部門未設定の場合は null",
            "example": "ABCD"
          },
          "two_factor_authentication_setting_type": {
            "allOf": [
              {
                "$ref": "#/components/schemas/PartnerManagement.Orderer.CompanyUsers.TwoFactorAuthenticationSettingType"
